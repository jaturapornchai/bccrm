# ===== Core =====
NODE_ENV=development
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001

# ===== Database (PostgreSQL) =====
DATABASE_URL=postgresql://bccrm:bccrm@localhost:5432/bccrm

# ===== Redis (สถานะคิวสด / BullMQ jobs) =====
REDIS_URL=redis://localhost:6379

# ===== Auth =====
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ===== LINE Platform (ต่อ tenant/สาขา — ค่าเริ่มต้นสำหรับ dev) =====
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LIFF_ID_BOOKING=
LINE_LIFF_ID_TICKET=
LINE_LIFF_ID_PROFILE=

# ===== Web Admin =====
ADMIN_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ===== LIFF app =====
LIFF_PORT=3002
VITE_API_URL=http://localhost:3001
VITE_LIFF_ID=

# ===== Queue policy =====
QUEUE_NOTIFY_AHEAD_COUNT=3
QUEUE_NO_SHOW_TIMEOUT_MINUTES=10
